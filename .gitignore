# ============================================================
# .gitignore - Jurideazor (RCR project)
# Rule of thumb: secrets, big data and machine-specific files stay OUT of Git.
# ============================================================
# 1. Secrets: never commit
.env
*.key

# 2. Python & Environments
__pycache__/
*.pyc
.venv/
venv/

# 3. Jupyter
.ipynb_checkpoints/

# 4. PDFs & Big Data (Heavy files)
data/raw/joradp/pdf/
*.zip
*.tar.gz
data/backup/

# 4b. OCR v1 text (superseded by text_v2; kept in the local tar.gz backup)
data/raw/joradp/text/

# 5. Databases & Caches (Binary files that change often)
*.sqlite
*.db
data/processed/downloads.sqlite
data/processed/llm_cache.sqlite

# 6. Search Vectors (Generated embeddings)
*.npy
*.faiss

# 7. Runtime artefacts & Logs
*.log
*.part
data/processed/download_failures.log

# 8. Test / packaging caches
.pytest_cache/
*.egg-info/

# 9. Auto-generated (can be re-generated from code)
data/processed/text_clean
data/raw/joradp/text
data/processed/texts_ar/

@'

# Generated processed data
data/processed/articles_all.json
data/processed/articles_test_ar.json
data/processed/articles_test_fr.json
data/processed/chunks.json
data/processed/*_report.csv
data/processed/downloads_manifest.csv
data/processed/dropped_lines_fr.txt
data/processed/issues_selected.csv
data/processed/texts/

# Generated raw data
data/raw/joradp/index/
data/raw/joradp/text/
data/raw/joradp/text_v2/
'@ | Add-Content .gitignore

# Arabic generated reports
data/processed/*report*.csv
